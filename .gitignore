*.iss.log

# Flutter 分析 / 测试临时输出
/analysis_output.txt
.flutter-plugins

# 个人图片素材（不入版本库）
/2233.jpg

# 操作系统 / 编辑器临时文件
Thumbs.db
desktop.ini
*.bak
*.tmp

# SSH 私钥文件（绝对不能提交）
